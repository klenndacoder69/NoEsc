# NoEsc ML listener deployment environment
# Copy to: /etc/noesc/ml_listener.env
# Or copy to: <project-root>/.env (auto-loaded by noesc-ml-listener-launcher)

# NOTE:
# install_daemon.sh seeds this file by replacing placeholders below with
# the detected project root and Python executable.

# Project location containing src/ml_engine/model_interface.py and models/
NOESC_PROJECT_ROOT=__NOESC_PROJECT_ROOT__

# Python binary used by service
NOESC_PYTHON_BIN=__NOESC_PYTHON_BIN__

# UDS socket where daemon sends ML events
NOESC_SOCKET_PATH=/tmp/noesc_ml.sock

# Listener behavior
NOESC_SHORT_SEQ_POLICY=infer
NOESC_SHORT_MODEL_ENABLED=1
NOESC_SHORT_MODEL_MAX_SEQ_LEN=2
NOESC_SHORT_MALICIOUS_SCORE_THRESHOLD=0.5
NOESC_ML_NOTIFY_MALICIOUS=0
NOESC_ML_NOTIFY_COOLDOWN_SECONDS=2.0
NOESC_ML_NOTIFY_CLOSE_SECONDS=5.0

# Optional explicit long-model artifacts (if unset, listener default candidates are used)
# NOESC_MODEL_PATH=models/v4/svm_model.pkl
# NOESC_VECTORIZER_PATH=models/v4/tfidf_vectorizer.pkl
# NOESC_METADATA_PATH=models/v4/training_metadata.json

# Optional explicit short-model artifacts (if unset, listener default candidates are used)
# NOESC_SHORT_MODEL_PATH=models/short_v1/svm_model.pkl
# NOESC_SHORT_VECTORIZER_PATH=models/short_v1/tfidf_vectorizer.pkl
# NOESC_SHORT_METADATA_PATH=models/short_v1/training_metadata.json
